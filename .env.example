# Leave a value empty to turn that part off.

# Telegram alerts: token from @BotFather, chat id from @userinfobot. Empty = alerts are only printed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Google Sheet with "Latest" and "Alerts" tabs: service-account JSON file + the long id in the sheet URL.
GOOGLE_CREDENTIALS=
SHEET_ID=
# Minutes between checks, as in deploy/price-tracker.timer: the dashboard's health check goes red after twice this.
CHECK_EVERY_MIN=30
