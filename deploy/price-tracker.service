# One check of every page. Started by price-tracker.timer; if it fails, price-tracker-failed.service sends a Telegram.
[Unit]
Description=Price tracker: check all pages once
Wants=network-online.target
After=network-online.target
OnFailure=price-tracker-failed.service

[Service]
Type=oneshot
User=pricetracker
WorkingDirectory=/opt/price-tracker
EnvironmentFile=/opt/price-tracker/.env
ExecStart=/opt/price-tracker/.venv/bin/python tracker.py
TimeoutStartSec=15min
